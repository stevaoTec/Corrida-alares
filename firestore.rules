rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
 function admin() { return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true; }
 match /admins/{uid} { allow get: if request.auth != null && request.auth.uid == uid; allow list, write: if false; }
 match /campaigns/alares { allow read: if true; allow create, update: if admin() && request.resource.data.keys().hasOnly(['config','sellers','history','updatedAt','revision']) && request.resource.data.config.keys().hasOnly(['prizeName','individualGoal','teamGoal']) && request.resource.data.sellers is list && request.resource.data.sellers.size() == 15 && request.resource.data.history is list && request.resource.data.revision is int; allow delete: if false; }
}}